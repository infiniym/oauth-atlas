// Summarize original recorder envelopes without reclassifying their outcomes.
// A recorder pass is not manual acceptance or a claim of live reliability.
import {readdirSync,readFileSync,writeFileSync} from 'node:fs';
import {join,relative} from 'node:path';
const root='docs/evidence/completion-2026-11-02',rows:any[]=[];
function walk(directory:string){for(const entry of readdirSync(directory,{withFileTypes:true})){const path=join(directory,entry.name);if(entry.isDirectory())walk(path);else if(/-r\d+\.json$/.test(entry.name)){
 const d=JSON.parse(readFileSync(path,'utf8'));if(!d.name||!d.input)continue;
 rows.push({evidence:relative(root,path),candidate:relative(root,directory),case:d.name,round:d.round,sourceCommit:d.release?.sourceCommit||null,guideCodeFingerprint:d.release?.guideCodeFingerprint||null,startedAt:d.startedAt||null,elapsedMs:d.elapsedMs??null,jobIds:(d.jobs||[]).map((j:any)=>j.id),modelCalls:d.job?.guide?.journey?.modelCalls??null,recorderResult:d.inProgress?'in-progress':d.pass===true?'pass':d.pass===false?'fail':'not-recorded',readiness:d.readiness||null,errors:d.errors||[],error:d.error||null});
 }}}
walk(root);rows.sort((a,b)=>(a.startedAt||'').localeCompare(b.startedAt||'')||a.evidence.localeCompare(b.evidence));
const groups=new Map<string,any>();for(const row of rows){const key=row.candidate+'#'+row.round;const g=groups.get(key)||{candidate:row.candidate,round:row.round,records:0,recorderPasses:0,recorderFailures:0,inProgress:0,cases:[],sourceCommits:[]};g.records++;g.recorderPasses+=Number(row.recorderResult==='pass');g.recorderFailures+=Number(row.recorderResult==='fail');g.inProgress+=Number(row.recorderResult==='in-progress');g.cases.push(row.case);if(row.sourceCommit&&!g.sourceCommits.includes(row.sourceCommit))g.sourceCommits.push(row.sourceCommit);groups.set(key,g);}
const output={generatedAt:new Date().toISOString(),scope:'Original named scenario recorder envelopes in this evidence directory. Schema/source probes, controlled model replays, recovery-specific records and unit fixtures are separate and excluded from these journey counts.',qualification:'Recorder passes require a separate source/request audit. They do not establish a complete round, universal reliability or the two consecutive final-candidate rounds. Original failed attempts are never replaced by later reruns.',summary:{records:rows.length,recorderPasses:rows.filter(r=>r.recorderResult==='pass').length,recorderFailures:rows.filter(r=>r.recorderResult==='fail').length,inProgress:rows.filter(r=>r.recorderResult==='in-progress').length,distinctJobs:new Set(rows.flatMap(r=>r.jobIds)).size},rounds:[...groups.values()],attempts:rows};
writeFileSync(join(root,'ATTEMPT-LEDGER.json'),JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify(output.summary));
